{
  "name": "elixirbooks",
  "private": true,
  "version": "2.9.0",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.19",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
