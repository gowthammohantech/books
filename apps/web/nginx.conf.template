worker_processes auto;
events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
  gzip_min_length 1024;

  server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Health check served by nginx itself (does not touch upstream)
    location = /healthz {
      access_log off;
      return 200 "ok\n";
    }

    # API proxy blocks are rendered here at container start by
    # docker-entrypoint.d/15-render-nginx-conf.sh, but ONLY when API_ORIGIN is
    # set (compose sets it to http://api:3001). nginx resolves upstream
    # hostnames at startup and aborts with [emerg] host not found when they do
    # not exist, so hardcoding `api:3001` made the image unbootable anywhere
    # the api container is not on the same network -- e.g. the standalone
    # App Service deploy, where the SPA calls the API directly through the
    # baked-in VITE_API_BASE_URL and needs no proxy at all.
#__API_PROXY__

    # Hashed build assets are content-addressed → safe to cache forever.
    location /assets/ {
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }

    # index.html must never be cached, otherwise clients keep loading an old
    # bundle hash after a deploy and never pick up new frontend code.
    location = /index.html {
      add_header Cache-Control "no-cache, no-store, must-revalidate";
      expires -1;
    }

    # SPA fallback — served HTML also gets no-cache (returns index.html).
    location / {
      add_header Cache-Control "no-cache, no-store, must-revalidate";
      expires -1;
      try_files $uri $uri/ /index.html;
    }
  }
}
