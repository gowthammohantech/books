{
  "name": "@elixirbooks/api",
  "version": "2.9.0",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon --exec \"node -r ts-node/register\" server.ts",
    "start": "node -r ts-node/register server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:check:tenant": "ts-node prisma/checkTenantIntegrity.ts",
    "prisma:seed": "prisma db seed",
    "prisma:seed:modules": "ts-node prisma/seedModules.ts",
    "prisma:seed:field-types": "ts-node prisma/seedFieldTypes.ts",
    "prisma:seed:notifications": "ts-node prisma/seedNotifications.ts",
    "prisma:seed:demo": "ts-node prisma/seed-demo.ts",
    "prisma:seed:demo:full": "ts-node prisma/seed-demo-full.ts",
    "prisma:import:geo": "ts-node prisma/importGeoDataset.ts",
    "prisma:migrate:contacts": "ts-node prisma/migrateContacts.ts",
    "prisma:migrate:taxes": "ts-node prisma/migrateTaxesToRates.ts",
    "prisma:backfill:contact-fks": "ts-node prisma/backfillContactFks.ts",
    "prisma:backfill:contacts": "ts-node prisma/migrateContacts.ts && ts-node prisma/backfillContactFks.ts",
    "prisma:backfill:ledger": "ts-node prisma/backfillLedgerInit.ts",
    "prisma:backfill:disposal-accounts": "ts-node prisma/backfillDisposalAccounts.ts",
    "prisma:backfill:employee-payable": "ts-node prisma/backfillEmployeePayableAccount.ts",
    "prisma:clear:demo": "ts-node prisma/clear-demo.ts",
    "setup": "prisma migrate deploy && prisma generate && prisma db seed"
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "_moduleAliases": {
    "@": "/",
    "@controllers": "controllers",
    "@middleware": "middleware",
    "@routes": "routes",
    "@utils": "utils",
    "@validators": "validators"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "~5.22.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "fastest-levenshtein": "^1.0.16",
    "geoip-lite": "^1.4.10",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "openai": "^6.32.0",
    "pdf-to-png-converter": "^3.18.0",
    "prisma": "~5.22.0",
    "razorpay": "^2.9.6",
    "stripe": "^22.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "~10.9.2",
    "typescript": "~5.6.3",
    "ua-parser-js": "^2.0.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "~3.0.0",
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/geoip-lite": "~1.4.4",
    "@types/jsonwebtoken": "~9.0.7",
    "@types/multer": "~1.4.12",
    "@types/node": "~20.16.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "~6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "~10.0.0",
    "@vitest/coverage-v8": "~2.1.9",
    "eslint": "~9.15.0",
    "eslint-import-resolver-typescript": "~3.6.3",
    "eslint-plugin-import": "~2.31.0",
    "nodemon": "^3.1.10",
    "supertest": "~7.0.0",
    "ts-node-dev": "~2.0.0",
    "tsconfig-paths": "~4.2.0",
    "typescript-eslint": "~8.15.0",
    "vitest": "~2.1.9"
  }
}
