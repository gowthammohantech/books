  payRunLines                PayRunLine[]          @relation("EmployeePayRunLines")
  expenseChangeLogs          ExpenseChangeLog[]    @relation("UserExpenseChangeLogs")
  purchasesBillFrom          Purchase[]            @relation("PurchaseBillFrom")
  purchasesBillTo            Purchase[]            @relation("PurchaseBillTo")
  purchaseOrdersBillFrom     PurchaseOrder[]       @relation("PurchaseOrderBillFrom")
  purchaseOrdersBillTo       PurchaseOrder[]       @relation("PurchaseOrderBillTo")
  currenciesCreated          Currency[]            @relation("CurrencyCreatedBy")
  dateFormatsCreated         DateFormat[]          @relation("DateFormatCreatedBy")
  dateFormatsUpdated         DateFormat[]          @relation("DateFormatUpdatedBy")
  timeFormatsCreated         TimeFormat[]          @relation("TimeFormatCreatedBy")
  timeFormatsUpdated         TimeFormat[]          @relation("TimeFormatUpdatedBy")
  generalSettingsCreated     GeneralSetting[]      @relation("GeneralSettingCreatedBy")
  generalSettingsUpdated     GeneralSetting[]      @relation("GeneralSettingUpdatedBy")
  customFieldDataTypes       CustomFieldDataType[] @relation("UserCustomFieldDataTypes")
  customFieldValues          CustomFieldValue[]    @relation("UserCustomFieldValues")
  invoicesAsBillFrom         Invoice[]             @relation("InvoiceBillFrom")
  invoicePaymentsReceived    InvoicePayment[]      @relation("InvoicePaymentReceivedBy")
  voidedInvoicePayments      InvoicePayment[]      @relation("UserVoidedInvoicePayments")
  quotationsAsSalesPerson    Quotation[]           @relation("QuotationSalesPerson")
  quotationsAsBillFrom       Quotation[]           @relation("QuotationBillFrom")
