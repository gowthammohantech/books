model SupplierPayment {
  id               String                    @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId         String
  tenant           Tenant                    @relation("TenantSupplierPayments", fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId        String? // TODO 0.1c: app-generated PAY-NNNNNN sequence
  purchaseId       String
  purchase         Purchase                  @relation("PurchaseSupplierPayments", fields: [purchaseId], references: [id])
  supplierId       String?
  supplier         Supplier?                 @relation("SupplierPaymentSupplier", fields: [supplierId], references: [id])
