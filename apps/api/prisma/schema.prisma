  sourceType       SupplierPaymentSourceType
  bankId           String?
  bank             BankDetail?               @relation("BankDetailSupplierPayments", fields: [bankId], references: [id])
  amount           Decimal                   @db.Decimal(18, 4)
  paidAmount       Decimal                   @db.Decimal(18, 4)
  dueAmount        Decimal                   @db.Decimal(18, 4)
  notes            String?
  attachment       String?
  isDeleted        Boolean                   @default(false)
  createdBy        String?
  createdByUser    User?                     @relation("UserSupplierPaymentsCreated", fields: [createdBy], references: [id])
  currencyCode     String?
  exchangeRate     Decimal?                  @db.Decimal(18, 8)
  // TRUE iff this payment's CREATE path moved a cash register (bankDetail or
  // pettyCash currentBalance). The record path createSupplierPayment moves it
  // for both BANK and PETTY_CASH; the EXPLAIN flow (applyBillPayment) sets
  // sourceType='BANK' but NEVER moves currentBalance (the pre-existing imported
  // statement line owns it). The delete/void reversal reverses the register IFF
  // this is TRUE — see the InvoicePayment.movedBankBalance note for why a
  // bank-line lookup cannot substitute for this persisted flag.
  movedBankBalance Boolean                   @default(false)
  isVoided         Boolean                   @default(false)
  voidedById       String?
  voidedBy         User?                     @relation("UserVoidedSupplierPayments", fields: [voidedById], references: [id])
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([tenantId, paymentId])
  @@index([tenantId])
}

