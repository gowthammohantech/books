/// A customer workspace. Every business row in this schema belongs to exactly
/// one Tenant, and lib/tenantGuard.ts filters every query by it.
///
/// On an install that predates multi-tenancy, tenant #1 is created with
/// `id` = the primary owner's User.id (see the tenant_core migration). That is
/// deliberate: every pre-existing tenant column already held `ownerId ?? id`,
/// so reusing the id makes the conversion a pure column rename with no data
/// movement, and leaves already-issued JWTs valid.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  plan      String?      @default("free")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  memberships TenantMembership[] @relation("TenantMemberships")
  roles       Role[]             @relation("TenantRoles")
  permissions Permission[]       @relation("TenantPermissions")
  users       User[]             @relation("UserLastTenant")

  // Tenant-owned business data. These moved off User in P3, when the tenant
  // column stopped meaning "the owner user" and started meaning "the workspace".
  aIChatSessions            AIChatSession[]            @relation("TenantAIChatSession")
  aIConfiguration           AIConfiguration?           @relation("TenantAIConfiguration")
  aIPromptLogs              AIPromptLog[]              @relation("TenantAIPromptLog")
  aIPromptTemplates         AIPromptTemplate[]         @relation("TenantAIPromptTemplate")
  accountCreditEntrys       AccountCreditEntry[]       @relation("TenantAccountCreditEntry")
  accountingIntegrations    AccountingIntegration[]    @relation("TenantAccountingIntegration")
  accountingPeriods         AccountingPeriod[]         @relation("TenantAccountingPeriod")
  accounts                  Account[]                  @relation("TenantAccount")
  aiChatSessions            AiChatSession[]            @relation("TenantAiChatSession")
  aiConfig                  AiConfig?                  @relation("TenantAiConfig")
  aiExtractionJobs          AiExtractionJob[]          @relation("TenantAiExtractionJob")
  aiUsageLogs               AiUsageLog[]               @relation("TenantAiUsageLog")
  bankDetails               BankDetail[]               @relation("TenantBankDetail")
  budgets                   Budget[]                   @relation("TenantBudget")
  companySettings           CompanySettings?           @relation("TenantCompanySettings")
  contacts                  Contact[]                  @relation("TenantContact")
  conversations             Conversation[]             @relation("TenantConversation")
  costCenters               CostCenter[]               @relation("TenantCostCenter")
  creditNotes               CreditNote[]               @relation("TenantCreditNote")
  customers                 Customer[]                 @relation("TenantCustomer")
  debitNotes                DebitNote[]                @relation("TenantDebitNote")
  deliveryChallans          DeliveryChallan[]          @relation("TenantDeliveryChallan")
  eInvoiceRecords           EInvoiceRecord[]           @relation("TenantEInvoiceRecord")
  emailSettingss            EmailSettings[]            @relation("TenantEmailSettings")
  exchangeRates             ExchangeRate[]             @relation("TenantExchangeRate")
  expenses                  Expense[]                  @relation("TenantExpense")
  explanationHints          ExplanationHint[]          @relation("TenantExplanationHint")
  fixedAssets               FixedAsset[]               @relation("TenantFixedAsset")
  gatewayConfigs            GatewayConfig[]            @relation("TenantGatewayConfig")
  holidays                  Holiday[]                  @relation("TenantHoliday")
  inventoryCostLayers       InventoryCostLayer[]       @relation("TenantInventoryCostLayer")
  inventorys                Inventory[]                @relation("TenantInventory")
  invoiceTemplates          InvoiceTemplate[]          @relation("TenantInvoiceTemplate")
  invoices                  Invoice[]                  @relation("TenantInvoice")
  journalEntrys             JournalEntry[]             @relation("TenantJournalEntry")
  leaveAllocations          LeaveAllocation[]          @relation("TenantLeaveAllocation")
  leaveRequests             LeaveRequest[]             @relation("TenantLeaveRequest")
  leaveTypes                LeaveType[]                @relation("TenantLeaveType")
  ledgerAccountMappings     LedgerAccountMapping[]     @relation("TenantLedgerAccountMapping")
  localizations             Localization[]             @relation("TenantLocalization")
  messagingConfig           MessagingConfig?           @relation("TenantMessagingConfig")
  mtdConfig                 MtdConfig?                 @relation("TenantMtdConfig")
  payRuns                   PayRun[]                   @relation("TenantPayRun")
  paymentLinkMethods        PaymentLinkMethod[]        @relation("TenantPaymentLinkMethod")
  paymentTransactions       PaymentTransaction[]       @relation("TenantPaymentTransaction")
  payrollProfiles           PayrollProfile[]           @relation("TenantPayrollProfile")
  pettyCashs                PettyCash[]                @relation("TenantPettyCash")
  projectMembers            ProjectMember[]            @relation("TenantProjectMember")
  projects                  Project[]                  @relation("TenantProject")
  purchaseOrders            PurchaseOrder[]            @relation("TenantPurchaseOrder")
  purchases                 Purchase[]                 @relation("TenantPurchase")
  quotations                Quotation[]                @relation("TenantQuotation")
  recurringInvoiceSchedules RecurringInvoiceSchedule[] @relation("TenantRecurringInvoiceSchedule")
  refunds                   Refund[]                   @relation("TenantRefund")
  signatures                Signature[]                @relation("TenantSignature")
  suppliers                 Supplier[]                 @relation("TenantSupplier")
  taxRates                  TaxRate[]                  @relation("TenantTaxRate")
  timesheets                Timesheet[]                @relation("TenantTimesheet")
  transactionCategorys      TransactionCategory[]      @relation("TenantTransactionCategory")
  vehicles                  Vehicle[]                  @relation("TenantVehicle")

  auditLogs AuditLog[] @relation("TenantAuditLogs")

  // Denormalized child tables (see the note on each model).
  invoicePayments       InvoicePayment[]       @relation("TenantInvoicePayments")
  supplierPayments      SupplierPayment[]      @relation("TenantSupplierPayments")
  expenseChangeLogs     ExpenseChangeLog[]     @relation("TenantExpenseChangeLogs")
  bankTransactions      BankTransaction[]      @relation("TenantBankTransactions")
  pettyCashTransactions PettyCashTransaction[] @relation("TenantPettyCashTransactions")
  journalLines          JournalLine[]          @relation("TenantJournalLines")
  aiChatMessages        AiChatMessage[]        @relation("TenantAiChatMessages")
  timeEntries           TimeEntry[]            @relation("TenantTimeEntries")
  leaveRequestDays      LeaveRequestDay[]      @relation("TenantLeaveRequestDays")
  payRunLines           PayRunLine[]           @relation("TenantPayRunLines")
  reminders             Reminder[]             @relation("TenantReminders")

  // Formerly install-global catalogs, tenant-scoped in P4.
  products             Product[]             @relation("TenantProduct")
  brands               Brand[]               @relation("TenantBrand")
  categories           Category[]            @relation("TenantCategory")
  units                Unit[]                @relation("TenantUnit")
  taxGroups            TaxGroup[]            @relation("TenantTaxGroup")
  expenseCategories    ExpenseCategory[]     @relation("TenantExpenseCategory")
  customFields         CustomField[]         @relation("TenantCustomField")
  customFieldValues    CustomFieldValue[]    @relation("TenantCustomFieldValue")
  customFieldDataTypes CustomFieldDataType[] @relation("TenantCustomFieldDataType")
  emailTemplates       EmailTemplate[]       @relation("TenantEmailTemplate")
  generalSettings      GeneralSetting[]      @relation("TenantGeneralSetting")
  currencies           Currency[]            @relation("TenantCurrency")

  apiKeys TenantApiKey[] @relation("TenantApiKeys")

  @@index([status])
}

/// Joins a User to a Tenant with a role. A user may hold memberships in several
/// tenants; the JWT names the one the session is currently acting on, and
/// POST /api/auth/switch-tenant mints a token for another.
///
/// `roleId` lives here rather than on User because a user's role is per-tenant:
/// an Owner in one workspace may be Staff in another.
model TenantMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant           @relation("TenantMemberships", fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?            @relation("RoleMemberships", fields: [roleId], references: [id])
  status    MembershipStatus @default(ACTIVE)
  isOwner   Boolean          @default(false)
  invitedBy String?
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

/// A server-to-server credential scoped to ONE workspace.
///
/// The external API (controllers/externalController.js) used to authenticate
/// against a single install-wide `WHATSAPPCRM_API_KEY` env var, which cannot
/// say WHICH company an incoming contact belongs to. A presented key now names
/// its tenant, so `upsertCustomer` writes into the right workspace by
/// construction rather than by guessing at the sole admin.
///
/// Only the SHA-256 of the key is stored — the key itself is shown once, at
/// creation, and is unrecoverable afterwards. `prefix` is the non-secret
/// leading characters, kept so a human can tell two keys apart in a list.
model TenantApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation("TenantApiKeys", fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
}

