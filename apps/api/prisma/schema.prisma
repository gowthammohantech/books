model BankDetail {
  id                String          @id @default(uuid())
  accountHoldername String
  bankName          String
  branchName        String
  // Uniqueness is enforced by a PARTIAL unique index over active (isDeleted =
  // false) rows only — see migration 20260711000000_bankdetail_active_unique_
  // accountnumber. Prisma can't express `WHERE isDeleted = false`, so no @unique
  // here; a soft-deleted account must not reserve its number forever.
  accountNumber     String
  // BC.2: regional bank-code format stored in IFSCCode (IFSC, SORT_CODE, ROUTING,
  // IBAN, SWIFT, BSB, OTHER); null = legacy (treat as IFSC)
  bankCodeType      String?
  IFSCCode          String
  accountType       BankAccountType
  openingBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  currentBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  asOnDate          DateTime?       @default(now())
  // BC.1: per-account currency (ISO code, e.g. 'USD'); null = company base currency
  currencyCode      String?
  isDeleted         Boolean         @default(false)
  status            Boolean         @default(true)
  tenantId          String
  tenant            Tenant          @relation("TenantBankDetail", fields: [tenantId], references: [id], onDelete: Restrict)
  // A1: per-bank GL sub-account under the tenant's BANK control account, so each
  // bank reconciles independently. Null = falls back to the shared BANK role account.
  accountId         String?
  account           Account?        @relation("BankDetailAccount", fields: [accountId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bankTransactions       BankTransaction[] @relation("BankDetailTransactions")
  supplierPayments       SupplierPayment[] @relation("BankDetailSupplierPayments")
  expenses               Expense[]         @relation("ExpenseBank")
  purchases              Purchase[]        @relation("PurchaseBank")
  purchaseOrders         PurchaseOrder[]   @relation("PurchaseOrderBank")
  creditNotesAsBank      CreditNote[]      @relation("CreditNoteBank")
  debitNotesAsBank       DebitNote[]       @relation("DebitNoteBank")
