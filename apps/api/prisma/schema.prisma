// =============================================================================
// Models — Accounting (F.1: Chart of Accounts + Journal Entries)
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation("TenantAccount", fields: [tenantId], references: [id], onDelete: Restrict)
  code                  String
  name                  String
  accountType           AccountType
  parentId              String?
  parent                Account?               @relation("AccountParent", fields: [parentId], references: [id])
  children              Account[]              @relation("AccountParent")
  description           String?
  currencyCode          String?
  roleProtected         Boolean                @default(false)
  isDeleted             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  journalLines          JournalLine[]
  roleMappings          LedgerAccountMapping[]
  budgets               Budget[]               @relation("AccountBudgets")
  transactionCategories TransactionCategory[]  @relation("AccountTransactionCategories")
  bankDetails           BankDetail[]           @relation("BankDetailAccount")

  @@unique([tenantId, code])
  @@index([tenantId, accountType])
}

model JournalEntry {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation("TenantJournalEntry", fields: [tenantId], references: [id], onDelete: Restrict)
  entryNumber       String?
  entryDate         DateTime
  postingDate       DateTime?
  description       String?
  reference         String?
  sourceType        String?
  sourceId          String?
  event             String?
  isSystemGenerated Boolean           @default(false)
  isOpeningBalance  Boolean           @default(false)
  reversedById      String?
  reversedBy        JournalEntry?     @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals         JournalEntry[]    @relation("JournalReversal")
  periodId          String?
  period            AccountingPeriod? @relation("PeriodJournalEntries", fields: [periodId], references: [id])
  lines             JournalLine[]
  isPosted          Boolean           @default(true)
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, sourceType, sourceId, event])
  @@index([tenantId, entryDate])
}

model JournalLine {
  id             String       @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId       String
  tenant         Tenant       @relation("TenantJournalLines", fields: [tenantId], references: [id], onDelete: Restrict)
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  currencyCode   String?
  exchangeRate   Decimal      @default(1) @db.Decimal(18, 8)
  baseDebit      Decimal      @default(0) @db.Decimal(18, 4)
  baseCredit     Decimal      @default(0) @db.Decimal(18, 4)
  taxRoleKey     String?
  description    String?
  costCenterId   String?
  costCenter     CostCenter?  @relation("CostCenterJournalLines", fields: [costCenterId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?     @relation("ProjectJournalLines", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([costCenterId])
  @@index([projectId])
  @@index([tenantId])
}

model LedgerAccountMapping {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation("TenantLedgerAccountMapping", fields: [tenantId], references: [id], onDelete: Restrict)
  roleKey   String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, roleKey])
  @@index([tenantId])
}

model AccountingPeriod {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation("TenantAccountingPeriod", fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean        @default(false)
  lockedAt       DateTime?
  lockedBy       String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntries JournalEntry[] @relation("PeriodJournalEntries")

  @@index([tenantId, startDate])
}

