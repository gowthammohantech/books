  @@index([tenantId])
  @@index([isDeleted])
  @@index([status])
}

model BankTransaction {
  id                         String                      @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId                   String
  tenant                     Tenant                      @relation("TenantBankTransactions", fields: [tenantId], references: [id], onDelete: Restrict)
  bankAccountId              String
  bankAccount                BankDetail                  @relation("BankDetailTransactions", fields: [bankAccountId], references: [id])
  transactionDate            DateTime                    @default(now())
  type                       BankTransactionType
  amount                     Decimal                     @db.Decimal(18, 4)
  balanceBefore              Decimal                     @db.Decimal(18, 4)
  balanceAfter               Decimal                     @db.Decimal(18, 4)
  paymentModeId              String
  paymentMode                PaymentMode                 @relation("PaymentModeBankTransactions", fields: [paymentModeId], references: [id])
  referenceNo                String?
  remarks                    String?
  relatedType                BankTransactionRelatedType? @default(MANUAL)
  relatedId                  String?
  isReconciled               Boolean                     @default(false)
  reconciledBy               String?
  reconciledByUser           User?                       @relation("UserReconciledBankTransactions", fields: [reconciledBy], references: [id])
  reconciliationDate         DateTime?
  reconciliationNote         String?
  isDeleted                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  explainStatus              ExplainStatus               @default(UNEXPLAINED)
  transactionTypeKey         String?
  categoryId                 String?
  category                   TransactionCategory?        @relation("CategoryBankTransactions", fields: [categoryId], references: [id])
  payToUserId                String?
  taxTreatment               String?
  taxAmount                  Decimal?                    @db.Decimal(18, 4)
  explainedDescription       String?
  attachment                 String?
  assetType                  String?
  depreciationMethod         String?
  assetLifeMonths            Int?
  userPaymentReason          String?
  approvedById               String?
  approvedAt                 DateTime?
  postedSourceType           String?
  postedSourceId             String?
  createdAssetId             String?
  proposedRelatedType        String?
  proposedRelatedId          String?
  matchConfidence            String?
  matchScore                 Int?
  proposedTransactionTypeKey String?
  proposedCategoryId         String?
  // Marks rows posted to the GL by the AUTO-POST tier (skipping the approval
  // queue). Drives the FE badge + Undo affordance and is cleared by unexplain.
  autoPosted                 Boolean                     @default(false)
  // True when this row was CREATED by a module payment flow (invoice payment,
  // supplier payment, expense, petty-cash) — see lib/moneyFlow/explainedBankFields.ts.
  // Payment-born rows are read-only in banking (edit at source); banking-explained
  // rows are always editable. Cleared by unexplain (converts to a normal manual row).
  isPaymentBorn              Boolean                     @default(false)

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([relatedType, relatedId])
  @@index([isDeleted])
  @@index([tenantId])
}

