// =============================================================================
// Audit trail (Activity Log)
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum CategoryGroup {
  ADMIN_EXPENSES
  GENERAL_OVERHEADS
  COST_OF_SALES
  PAYROLL
  TAXES
  INCOME
  CAPITAL
  OWNER_FUNDS
  USER_PAYMENTS
}

enum CategoryAppliesTo {
  MONEY_IN
  MONEY_OUT
  MONEY_IN_USER
  MONEY_OUT_USER
}

enum ExplainStatus {
  UNEXPLAINED
  FOR_APPROVAL
  EXPLAINED
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  entityType    String
  entityId      String?
  entityLabel   String?
  summary       String
  changes       Json?
  affectedCount Int?
  // The ACTOR, not the tenant. Deliberately left as userId.
  userId        String?
  user          User?       @relation("UserAuditLogs", fields: [userId], references: [id])
  // The tenant the audited write belonged to. Nullable because system work
  // (seeds, boot backfills, migrations -- anything under runAsSystem) has no
  // tenant, and an audit row is worth keeping even then.
  tenantId      String?
  tenant        Tenant?     @relation("TenantAuditLogs", fields: [tenantId], references: [id], onDelete: SetNull)
  userName      String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// =============================================================================
// Multi-Currency — Spec G
// =============================================================================

model ExchangeRate {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation("TenantExchangeRate", fields: [tenantId], references: [id], onDelete: Restrict)
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 8)
  asOfDate     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, fromCurrency, toCurrency, asOfDate])
}

// =============================================================================
// P3.3 — Cost Centers / Job Costing
// =============================================================================

model CostCenter {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation("TenantCostCenter", fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  /// PROFIT centres earn revenue, COST centres only absorb cost, BOTH does
  /// either. Defaults to BOTH so pre-existing centres keep their full reach.
  type        CostCenterType @default(BOTH)
  isActive    Boolean        @default(true)
  isDeleted   Boolean        @default(false)

  /// Roll-up hierarchy, e.g. Division > Department.
  parentId String?
  parent   CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCenter[] @relation("CostCenterHierarchy")

  /// Per-centre document numbering. A centre with a `numberPrefix` issues its
  /// own series (SAL-000001, ACAD-000001, ...) counted by `nextNumber`; a centre
  /// without one falls back to the install-wide sequence in GeneralSetting.
  numberPrefix String?
  nextNumber   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines     JournalLine[]     @relation("CostCenterJournalLines")
  invoices         Invoice[]         @relation("CostCenterInvoices")
  expenses         Expense[]         @relation("CostCenterExpenses")
  purchases        Purchase[]        @relation("CostCenterPurchases")
  quotations       Quotation[]       @relation("CostCenterQuotations")
  creditNotes      CreditNote[]      @relation("CostCenterCreditNotes")
  debitNotes       DebitNote[]       @relation("CostCenterDebitNotes")
  purchaseOrders   PurchaseOrder[]   @relation("CostCenterPurchaseOrders")
  deliveryChallans DeliveryChallan[] @relation("CostCenterDeliveryChallans")

  @@unique([tenantId, code])
  /// Postgres treats NULLs as distinct here, so unprefixed centres coexist
  /// freely while two centres can never share a live document series.
  @@unique([tenantId, numberPrefix])
  @@index([tenantId])
  @@index([parentId])
  @@index([tenantId, isDeleted])
}

enum CostCenterType {
  PROFIT
  COST
  BOTH
}

model Project {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation("TenantProject", fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  status      String    @default("active")
  billingRate Decimal?  @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  journalLines JournalLine[]   @relation("ProjectJournalLines")
  invoices     Invoice[]       @relation("ProjectInvoices")
  expenses     Expense[]       @relation("ProjectExpenses")
  purchases    Purchase[]      @relation("ProjectPurchases")
  members      ProjectMember[]
  timeEntries  TimeEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// =============================================================================
// Time Tracking — Phase 1 (ProjectMember / Timesheet / TimeEntry)
// =============================================================================

enum ProjectMemberRole {
  MEMBER
  MANAGER
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ProjectMember {
  id             String            @id @default(uuid())
  tenantId       String // tenant (raw, matches Project)
  tenant         Tenant            @relation("TenantProjectMember", fields: [tenantId], references: [id], onDelete: Restrict)
  projectId      String
  employeeUserId String
  role           ProjectMemberRole @default(MEMBER)
  billingRate    Decimal?          @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee User    @relation("ProjectMemberEmployee", fields: [employeeUserId], references: [id])

  @@unique([projectId, employeeUserId])
  @@index([tenantId])
  @@index([employeeUserId])
}

model Timesheet {
  id             String          @id @default(uuid())
  tenantId       String // tenant
  tenant         Tenant          @relation("TenantTimesheet", fields: [tenantId], references: [id], onDelete: Restrict)
  employeeUserId String
  weekStartDate  DateTime // Monday, UTC midnight
  status         TimesheetStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee User        @relation("TimesheetEmployee", fields: [employeeUserId], references: [id])
  entries  TimeEntry[]

  @@unique([employeeUserId, weekStartDate])
  @@index([tenantId])
  @@index([status])
}

model TimeEntry {
  id          String   @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId    String
  tenant      Tenant   @relation("TenantTimeEntries", fields: [tenantId], references: [id], onDelete: Restrict)
  timesheetId String
  projectId   String
  date        DateTime
  hours       Decimal  @db.Decimal(5, 2)
  billable    Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([date])
  @@index([tenantId])
}

// =============================================================================
// Time Tracking — Phase C (Leaves + Holidays)
// =============================================================================

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeavePortion {
  FULL
  AM
  PM
}

model Holiday {
  id              String   @id @default(uuid())
  tenantId        String // tenant (raw, matches Project)
  tenant          Tenant   @relation("TenantHoliday", fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  date            DateTime // UTC midnight (date-only)
  recurringYearly Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

model LeaveType {
  id                    String   @id @default(uuid())
  tenantId              String // tenant
  tenant                Tenant   @relation("TenantLeaveType", fields: [tenantId], references: [id], onDelete: Restrict)
  name                  String
  paid                  Boolean  @default(true)
  defaultAllocationDays Decimal? @db.Decimal(5, 1)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  allocations LeaveAllocation[]
  requests    LeaveRequest[]

  @@unique([tenantId, name])
}

model LeaveAllocation {
  id              String   @id @default(uuid())
  tenantId        String // tenant
  tenant          Tenant   @relation("TenantLeaveAllocation", fields: [tenantId], references: [id], onDelete: Restrict)
  employeeUserId  String
  leaveTypeId     String
  year            Int
  allocatedDays   Decimal  @db.Decimal(5, 1)
  carriedOverDays Decimal  @default(0) @db.Decimal(5, 1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee  User      @relation("LeaveAllocationEmployee", fields: [employeeUserId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeUserId, leaveTypeId, year])
  @@index([tenantId])
}

model LeaveRequest {
  id             String      @id @default(uuid())
  tenantId       String // tenant
  tenant         Tenant      @relation("TenantLeaveRequest", fields: [tenantId], references: [id], onDelete: Restrict)
  employeeUserId String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  status         LeaveStatus @default(PENDING)
  reason         String?
  totalDays      Decimal     @db.Decimal(5, 1)
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee  User              @relation("LeaveRequestEmployee", fields: [employeeUserId], references: [id])
  leaveType LeaveType         @relation(fields: [leaveTypeId], references: [id])
  days      LeaveRequestDay[]

  @@index([tenantId])
  @@index([employeeUserId])
  @@index([status])
}

model LeaveRequestDay {
  id             String       @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId       String
  tenant         Tenant       @relation("TenantLeaveRequestDays", fields: [tenantId], references: [id], onDelete: Restrict)
  leaveRequestId String
  date           DateTime
  portion        LeavePortion @default(FULL)
  portionDays    Decimal      @db.Decimal(2, 1)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date])
  @@index([date])
  @@index([tenantId])
}

