// Recurring engine v2: a non-posting schedule that holds an invoice TEMPLATE + cadence + lifecycle.
// NEVER posts to GL or touches inventory — only the generated child Invoices (recurringScheduleId) do.
model RecurringInvoiceSchedule {
  id                   String                        @id @default(uuid())
  tenantId             String // tenant scope (raw string, app-enforced — mirrors Invoice/Contact tenant column)
  tenant               Tenant                        @relation("TenantRecurringInvoiceSchedule", fields: [tenantId], references: [id], onDelete: Restrict)
  name                 String? // human label for the schedule
  contactId            String?
  contact              Contact?                      @relation("RecurringScheduleContact", fields: [contactId], references: [id])
  currencyCode         String?
  taxTreatment         TaxTreatment?
  // Invoice template snapshot (line items + amounts); rendered into a real Invoice at each run.
  items                Json
  taxableAmount        Decimal                       @db.Decimal(18, 4)
  totalDiscount        Decimal?                      @db.Decimal(18, 4)
  totalTax             Decimal?                      @db.Decimal(18, 4)
  roundOff             Decimal?                      @db.Decimal(18, 4)
  TotalAmount          Decimal                       @db.Decimal(18, 4)
  notes                String?
  termsAndCondition    String?
  signatureId          String?
  billFrom             String?
  // Cadence (reuses the existing recurrence enums)
  repeatEvery          RecurrenceFrequency           @default(month)
  customIntervalNumber Int?
  customIntervalType   RecurrenceCustomIntervalType?
  // End conditions
  startOn              DateTime
  endsOn               DateTime?
  neverExpire          Boolean                       @default(false)
  maxOccurrences       Int?
  // Lifecycle
  status               RecurringScheduleStatus       @default(ACTIVE)
  nextRunDate          DateTime?
  lastRunDate          DateTime?
  occurrencesCount     Int                           @default(0)
  generatedInvoices    Invoice[]                     @relation("RecurringScheduleInvoices")
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([tenantId])
  @@index([status])
}

model InvoicePayment {
  id                   String              @id @default(uuid())
  // Denormalized tenant. This table reaches its tenant only through a parent
  // FK, but lib/tenantGuard.ts can inject a top-level `where` and nothing
  // else, so the column has to live here. prisma/checkTenantIntegrity.ts
  // asserts it always matches the parent.
  tenantId             String
  tenant               Tenant              @relation("TenantInvoicePayments", fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId            String
  invoice              Invoice             @relation("InvoicePaymentInvoice", fields: [invoiceId], references: [id])
  amount               Decimal             @db.Decimal(18, 4)
  paymentModeId        String
  paymentMode          PaymentMode         @relation("PaymentModeInvoicePayments", fields: [paymentModeId], references: [id])
  bankId               String?
  bank                 BankDetail?         @relation("InvoicePaymentBank", fields: [bankId], references: [id])
  received_on          DateTime
  notes                String?             @default("")
  received_by          String
  receivedByUser       User                @relation("InvoicePaymentReceivedBy", fields: [received_by], references: [id])
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation("InvoicePaymentTxnLink", fields: [paymentTransactionId], references: [id])
  currencyCode         String?
  exchangeRate         Decimal?            @db.Decimal(18, 8)
  reference            String?
  // TRUE iff this payment's CREATE path moved bankDetail.currentBalance (the
  // record path recordInvoicePayment writes its own bank line + moves the
  // register). FALSE for the bank-reconciliation EXPLAIN flow (applyInvoiceReceipt),
  // where a pre-existing imported statement line already owns the money. The
  // delete/void reversal (voidPaymentEffects) reverses the register IFF this is
  // TRUE — the persisted signal is the only reliable discriminator because the
  // explain flow RELABELS the imported line with the same relatedType/relatedId/
  // postedSourceType this payment would, so a bank-line lookup cannot tell them apart.
  movedBankBalance     Boolean             @default(false)
  isVoided             Boolean             @default(false)
  voidedById           String?
  voidedBy             User?               @relation("UserVoidedInvoicePayments", fields: [voidedById], references: [id])
  voidedAt             DateTime?
  voidReason           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  accountCreditEntries AccountCreditEntry[] @relation("AccountCreditEntryInvoicePayment")

  @@index([tenantId])
}

// Per-contact "Account Credit": a running credit a business can manually grant a
// customer (goodwill, timely-payment bonus, promo) and later redeem against a
// future invoice. GRANT rows are created by the grant endpoint (posts
// Dr CUSTOMER_CREDIT_EXPENSE / Cr ACCOUNT_CREDIT); REDEMPTION rows are written by
// the (separate) invoice-payment redemption flow. Balance is ALWAYS computed on
// the fly (see lib/contacts/accountCreditBalance.ts) — never stored denormalized.
enum AccountCreditEntryType {
  GRANT
  REDEMPTION
}

model AccountCreditEntry {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           Tenant                 @relation("TenantAccountCreditEntry", fields: [tenantId], references: [id], onDelete: Restrict)
  contactId        String
  contact          Contact                @relation("AccountCreditEntryContact", fields: [contactId], references: [id])
  type             AccountCreditEntryType
  amount           Decimal                @db.Decimal(18, 4) // always positive; sign implied by type
  reason           String?
  invoiceId        String?
  invoice          Invoice?               @relation("AccountCreditEntryInvoice", fields: [invoiceId], references: [id])
  invoicePaymentId String?
  invoicePayment   InvoicePayment?        @relation("AccountCreditEntryInvoicePayment", fields: [invoicePaymentId], references: [id])
  currencyCode     String?
  isVoided         Boolean                @default(false)
  voidedById       String?
  voidedAt         DateTime?
  voidReason       String?
  createdById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([tenantId, contactId])
  @@index([invoiceId])
  @@index([invoicePaymentId])
}

