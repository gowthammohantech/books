// Generated by Slice 0.1b — Postgres + Prisma schema.
// Mechanical translation of the 58 Mongoose models under ../models/.
// Controller conversion happens in Slices 0.1c-0.1e.
//
// Conventions (per slice 0.1b plan):
// - Primary key: id String @id @default(uuid())
// - Money: Decimal @db.Decimal(18, 4); tax rates: Decimal @db.Decimal(8, 4)
// - Subdocument arrays kept as Json for now; normalisation in later slices
// - Field names kept verbatim from Mongoose (no rename)
// - Relations include forward + back. Polymorphic refs stay as plain String
//   with no @relation (entityType + entityId pattern).
// - "// TODO 0.1c: ..." marks defaults/validations that don't translate
//   directly and must be handled in the service layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

