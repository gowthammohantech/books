// =============================================================================
// Models — Tenancy
// =============================================================================

/// A customer workspace. Every business row in this schema belongs to exactly
/// one Tenant, and lib/tenantGuard.ts filters every query by it.
///
/// On an install that predates multi-tenancy, tenant #1 is created with
/// `id` = the primary owner's User.id (see the tenant_core migration). That is
/// deliberate: every pre-existing tenant column already held `ownerId ?? id`,
/// so reusing the id makes the conversion a pure column rename with no data
/// movement, and leaves already-issued JWTs valid.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  plan      String?      @default("free")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  memberships TenantMembership[] @relation("TenantMemberships")
  roles       Role[]             @relation("TenantRoles")
  permissions Permission[]       @relation("TenantPermissions")
  users       User[]             @relation("UserLastTenant")

  @@index([status])
}

/// Joins a User to a Tenant with a role. A user may hold memberships in several
/// tenants; the JWT names the one the session is currently acting on, and
/// POST /api/auth/switch-tenant mints a token for another.
///
/// `roleId` lives here rather than on User because a user's role is per-tenant:
/// an Owner in one workspace may be Staff in another.
model TenantMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant           @relation("TenantMemberships", fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?            @relation("RoleMemberships", fields: [roleId], references: [id])
  status    MembershipStatus @default(ACTIVE)
  isOwner   Boolean          @default(false)
  invitedBy String?
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

