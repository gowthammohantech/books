  pettyCash       PettyCash                       @relation("PettyCashTransactions", fields: [pettyCashId], references: [id])
  transactionDate DateTime                        @default(now())
  transactionType PettyCashTransactionType
  amount          Decimal                         @db.Decimal(18, 4)
  balanceBefore   Decimal                         @db.Decimal(18, 4)
  balanceAfter    Decimal                         @db.Decimal(18, 4)
  remarks         String?
  relatedType     PettyCashTransactionRelatedType
  relatedId       String
  isDeleted       Boolean                         @default(false)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([pettyCashId])
  @@index([transactionDate])
  @@index([relatedType, relatedId])
  @@index([isDeleted])
}

