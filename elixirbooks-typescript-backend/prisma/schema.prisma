model TaxRate {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation("UserTaxRates", fields: [userId], references: [id])
  regime            TaxRegime
  taxKind           TaxKind?
  name              String
  rate              Decimal   @db.Decimal(7, 4)
  countryId         String?
  country           Country?  @relation("TaxRateCountry", fields: [countryId], references: [id])
