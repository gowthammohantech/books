// =============================================================================
// P3.3 — Cost Centers / Job Costing
// =============================================================================

model CostCenter {
  id          String         @id @default(uuid())
  userId      String
  code        String
  name        String
  description String?
  /// PROFIT centres earn revenue, COST centres only absorb cost, BOTH does
  /// either. Defaults to BOTH so pre-existing centres keep their full reach.
  type        CostCenterType @default(BOTH)
  isActive    Boolean        @default(true)
  isDeleted   Boolean        @default(false)

  /// Roll-up hierarchy, e.g. Division > Department.
  parentId String?
  parent   CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCenter[] @relation("CostCenterHierarchy")

  /// Per-centre document numbering. A centre with a `numberPrefix` issues its
  /// own series (SAL-000001, ACAD-000001, ...) counted by `nextNumber`; a centre
  /// without one falls back to the install-wide sequence in GeneralSetting.
  numberPrefix String?
  nextNumber   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines     JournalLine[]     @relation("CostCenterJournalLines")
  invoices         Invoice[]         @relation("CostCenterInvoices")
  expenses         Expense[]         @relation("CostCenterExpenses")
  purchases        Purchase[]        @relation("CostCenterPurchases")
  quotations       Quotation[]       @relation("CostCenterQuotations")
  creditNotes      CreditNote[]      @relation("CostCenterCreditNotes")
  debitNotes       DebitNote[]       @relation("CostCenterDebitNotes")
  purchaseOrders   PurchaseOrder[]   @relation("CostCenterPurchaseOrders")
  deliveryChallans DeliveryChallan[] @relation("CostCenterDeliveryChallans")

  @@unique([userId, code])
  /// Postgres treats NULLs as distinct here, so unprefixed centres coexist
  /// freely while two centres can never share a live document series.
  @@unique([userId, numberPrefix])
  @@index([userId])
  @@index([parentId])
  @@index([userId, isDeleted])
}

enum CostCenterType {
  PROFIT
  COST
  BOTH
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  code        String
  name        String
  description String?
  status      String    @default("active")
  billingRate Decimal?  @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  journalLines JournalLine[]   @relation("ProjectJournalLines")
  invoices     Invoice[]       @relation("ProjectInvoices")
  expenses     Expense[]       @relation("ProjectExpenses")
  purchases    Purchase[]      @relation("ProjectPurchases")
  members      ProjectMember[]
  timeEntries  TimeEntry[]

  @@unique([userId, code])
  @@index([userId])
}

