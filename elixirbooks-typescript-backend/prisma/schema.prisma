  native    String?
  region    String?
  subregion String?

  states          State[]           @relation("CountryStates")
  cities          City[]            @relation("CountryCities")
  users           User[]            @relation("CountryUsers")
  taxRates        TaxRate[]         @relation("TaxRateCountry")
  companySettings CompanySettings[] @relation("CompanySettingsCountry")
}

model CompanySettings {
  id                   String    @id @default(uuid())
  companyName          String
  email                String
  phone                String
  address              String
  city                 String
  state                String
  country              String
  pincode              String
  siteLogo             String?   @default("")
  favicon              String?   @default("")
  companyLogo          String?   @default("")
  companyBanner        String?   @default("")
  fax                  String?
  userId               String    @unique
  user                 User      @relation("UserCompanySettings", fields: [userId], references: [id])
  taxRegime            TaxRegime @default(NONE)
  countryId            String?
  countryRef           Country?  @relation("CompanySettingsCountry", fields: [countryId], references: [id])
  stateId              String?
  publicBaseUrl        String?
  merchantUpiId        String?
  merchantName         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  countryCode          String?
  functionalCurrency   String?
  fiscalYearStartMonth Int?
  goLiveDate           DateTime?
  ledgerInitialized    Boolean   @default(false)
  approvalsEnabled     Boolean   @default(false)

  // Per-tenant AUTO-POST tier for bank-transaction auto-matching. OFF BY DEFAULT —
  // preserves the existing queue behaviour (AUTO matches only fill the approval
  // queue). When ON, near-certain matches (see autoPostEligible in
  // lib/moneyFlow/autoMatch.ts) post straight to the GL, skipping the approval
  // queue. This is an explicit opt-in and is honoured INDEPENDENTLY of
  // approvalsEnabled: a maker-checker tenant that also opts into auto-post has
  // deliberately chosen to bypass review for the strongest matches (the strict
  // eligibility bar + one-click unexplain undo are the compensating controls).
  bankAutoPostEnabled Boolean @default(false)

  // Invoice item-picker display toggles — per-tenant, control which extra
  // columns/affordances show in the invoice line-item product picker.
  itemPickerShowRate  Boolean @default(true)
  itemPickerShowStock Boolean @default(true)
  itemPickerShowImage Boolean @default(false)

  // OPTIONAL online EU VIES VAT-number validation. OFF BY DEFAULT — VIES is an
  // outbound call to the EU government service, so it must never fire unless the
  // tenant explicitly opts in. Validation is fail-open and non-blocking: a save
  // is never rejected on a VIES result, only the audit flag on Contact is set.
  viesValidationEnabled Boolean @default(false)

  // EU One-Stop-Shop (OSS) registration. When ON, B2C cross-border EU supplies are
  // taxed at the DESTINATION member-state rate (instead of origin). OFF BY DEFAULT —
  // additive / backward-compatible; reverse-charge (B2B) and domestic behaviour are
  // unaffected.
  ossRegistered Boolean @default(false)

  // Tax registration identifiers (tenant-level). Nullable / additive — null = not registered.
  gstin       String? // India GSTIN (also used by e-invoicing)
  vatNumber   String? // UK / EU VAT registration number
  abn         String? // Australia Business Number
  nzGstNumber String? // New Zealand GST registration number

  reminders Reminder[] @relation("CompanySettingsReminders")
}

