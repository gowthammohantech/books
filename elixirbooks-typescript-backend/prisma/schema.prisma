// =============================================================================
// Models — Core entities (B)
// =============================================================================

model BankDetail {
  id                String          @id @default(uuid())
  accountHoldername String
  bankName          String
  branchName        String
  // Uniqueness is enforced by a PARTIAL unique index over active (isDeleted =
  // false) rows only — see migration 20260711000000_bankdetail_active_unique_
  // accountnumber. Prisma can't express `WHERE isDeleted = false`, so no @unique
  // here; a soft-deleted account must not reserve its number forever.
  accountNumber     String
  // BC.2: regional bank-code format stored in IFSCCode (IFSC, SORT_CODE, ROUTING,
  // IBAN, SWIFT, BSB, OTHER); null = legacy (treat as IFSC)
  bankCodeType      String?
  IFSCCode          String
  accountType       BankAccountType
  openingBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  currentBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  asOnDate          DateTime?       @default(now())
  // BC.1: per-account currency (ISO code, e.g. 'USD'); null = company base currency
  currencyCode      String?
  isDeleted         Boolean         @default(false)
  status            Boolean         @default(true)
  userId            String
  user              User            @relation("UserBankDetails", fields: [userId], references: [id])
  // A1: per-bank GL sub-account under the tenant's BANK control account, so each
  // bank reconciles independently. Null = falls back to the shared BANK role account.
  accountId         String?
  account           Account?        @relation("BankDetailAccount", fields: [accountId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bankTransactions       BankTransaction[] @relation("BankDetailTransactions")
  supplierPayments       SupplierPayment[] @relation("BankDetailSupplierPayments")
  expenses               Expense[]         @relation("ExpenseBank")
  purchases              Purchase[]        @relation("PurchaseBank")
  purchaseOrders         PurchaseOrder[]   @relation("PurchaseOrderBank")
  creditNotesAsBank      CreditNote[]      @relation("CreditNoteBank")
  debitNotesAsBank       DebitNote[]       @relation("DebitNoteBank")
  deliveryChallansAsBank DeliveryChallan[] @relation("DeliveryChallanBank")
  invoicesAsBank         Invoice[]         @relation("InvoiceBank")
  invoicePayments        InvoicePayment[]  @relation("InvoicePaymentBank")
  quotationsAsBank       Quotation[]       @relation("QuotationBank")

  @@index([userId])
  @@index([isDeleted])
  @@index([status])
}

model BankTransaction {
  id                         String                      @id @default(uuid())
  bankAccountId              String
  bankAccount                BankDetail                  @relation("BankDetailTransactions", fields: [bankAccountId], references: [id])
  transactionDate            DateTime                    @default(now())
  type                       BankTransactionType
  amount                     Decimal                     @db.Decimal(18, 4)
  balanceBefore              Decimal                     @db.Decimal(18, 4)
  balanceAfter               Decimal                     @db.Decimal(18, 4)
  paymentModeId              String
  paymentMode                PaymentMode                 @relation("PaymentModeBankTransactions", fields: [paymentModeId], references: [id])
  referenceNo                String?
  remarks                    String?
  relatedType                BankTransactionRelatedType? @default(MANUAL)
  relatedId                  String?
  isReconciled               Boolean                     @default(false)
  reconciledBy               String?
  reconciledByUser           User?                       @relation("UserReconciledBankTransactions", fields: [reconciledBy], references: [id])
  reconciliationDate         DateTime?
  reconciliationNote         String?
  isDeleted                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  explainStatus              ExplainStatus               @default(UNEXPLAINED)
  transactionTypeKey         String?
  categoryId                 String?
  category                   TransactionCategory?        @relation("CategoryBankTransactions", fields: [categoryId], references: [id])
  payToUserId                String?
  taxTreatment               String?
  taxAmount                  Decimal?                    @db.Decimal(18, 4)
  explainedDescription       String?
  attachment                 String?
  assetType                  String?
  depreciationMethod         String?
  assetLifeMonths            Int?
  userPaymentReason          String?
  approvedById               String?
  approvedAt                 DateTime?
  postedSourceType           String?
  postedSourceId             String?
  createdAssetId             String?
  proposedRelatedType        String?
  proposedRelatedId          String?
  matchConfidence            String?
  matchScore                 Int?
  proposedTransactionTypeKey String?
  proposedCategoryId         String?
  // Marks rows posted to the GL by the AUTO-POST tier (skipping the approval
  // queue). Drives the FE badge + Undo affordance and is cleared by unexplain.
  autoPosted                 Boolean                     @default(false)
  // True when this row was CREATED by a module payment flow (invoice payment,
  // supplier payment, expense, petty-cash) — see lib/moneyFlow/explainedBankFields.ts.
  // Payment-born rows are read-only in banking (edit at source); banking-explained
  // rows are always editable. Cleared by unexplain (converts to a normal manual row).
  isPaymentBorn              Boolean                     @default(false)

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([relatedType, relatedId])
  @@index([isDeleted])
}

