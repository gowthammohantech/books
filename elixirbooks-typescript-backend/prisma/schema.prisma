model Permission {
  id        String    @id @default(uuid())
  // Denormalized from Role.tenantId so the tenant guard can filter Permission
  // with a top-level `where` instead of a relation traversal. Kept in sync by
  // every writer; prisma/checkTenantIntegrity.ts asserts it matches the Role.
  tenantId  String
  tenant    Tenant    @relation("TenantPermissions", fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role      @relation("RolePermissions", fields: [roleId], references: [id])
  moduleId  String?
  module    Module?   @relation("ModulePermissions", fields: [moduleId], references: [id])
  create    Boolean   @default(false)
  edit      Boolean   @default(false)
  delete    Boolean   @default(false)
  view      Boolean   @default(false)
  allowAll  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}

model Role {
  id           String    @id @default(uuid())
  // Roles are per-tenant: each workspace owns its own Owner/Admin/Staff/... set
  // and may rename or re-permission them without affecting anyone else.
  // Module stays global — it names features, not data.
  tenantId     String
  tenant       Tenant    @relation("TenantRoles", fields: [tenantId], references: [id], onDelete: Cascade)
  roleName     String
  status       Boolean   @default(true)
  defaultRoute String?   @default("dashboard")
  createdBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissions Permission[]       @relation("RolePermissions")
  users       User[]             @relation("UserRole")
  memberships TenantMembership[] @relation("RoleMemberships")

  // NOTE: deliberately no @@unique([tenantId, roleName]).
  // deleteRole soft-deletes (sets deletedAt) and every name-uniqueness check in
  // roleController is scoped to `deletedAt: null`, so a plain unique constraint
  // would make "delete a role, then recreate it with the same name" fail with a
  // P2002. The correct DB-level constraint is a PARTIAL unique index
  // (... WHERE "deletedAt" IS NULL), which Prisma 5 cannot express in the
  // schema — declaring it in raw SQL only would show up as permanent drift on
  // every `prisma migrate dev`. Uniqueness therefore stays where it already
  // lives: the case-insensitive, tenant-scoped checks in roleController and
  // lib/defaultRoles.ensureRole.
  @@index([tenantId])
}

model User {
  id           String           @id @default(uuid())
  firstName    String
  lastName     String?
  email        String           @unique
  phone        String?
  gender       UserGender?
  dateOfBirth  DateTime?
  password     String
  profileImage String?
  address      String?
  countryId    String?
  country      Country?         @relation("CountryUsers", fields: [countryId], references: [id])
  stateId      String?
  state        State?           @relation("StateUsers", fields: [stateId], references: [id])
  cityId       String?
  city         City?            @relation("CityUsers", fields: [cityId], references: [id])
  postalCode   String?
  user_type    Int              @default(1)
  roleId       String?
  role         Role?            @relation("UserRole", fields: [roleId], references: [id])
  // Shared-workspace tenancy: links a staff/admin user to the sole company
  // owner (the single user_type:1 account). `ownerId = null` means the row IS
  // the owner, so the tenant id resolves to `ownerId ?? id` and every member
  // of a company shares one dataset. See lib/tenantScope.ts + seedUserOwner.ts.
  ownerId      String?
  owner        User?            @relation("UserOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  staff        User[]           @relation("UserOwner")
  // Which workspace to open on next login, for users who belong to several.
  // Advisory only — a membership is still required and re-checked every request.
  lastTenantId String?
  lastTenant   Tenant?          @relation("UserLastTenant", fields: [lastTenantId], references: [id], onDelete: SetNull)
  balance      Decimal          @default(0) @db.Decimal(18, 4)
  balance_type UserBalanceType?
  isDeleted    Boolean          @default(false)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // --- Back-relations from other batches ---
  memberships                TenantMembership[]      @relation("UserMemberships")
  loginActivities            LoginActivity[]         @relation("UserLoginActivities")
  bankDetails                BankDetail[]            @relation("UserBankDetails")
  reconciledBankTxs          BankTransaction[]       @relation("UserReconciledBankTransactions")
  customers                  Customer[]              @relation("UserCustomers")
  inventories                Inventory[]             @relation("UserInventories")
  pettyCashAccounts          PettyCash[]             @relation("UserPettyCash")
  signatures                 Signature[]             @relation("UserSignatures")
