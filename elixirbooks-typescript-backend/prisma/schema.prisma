model PettyCash {
  id             String   @id @default(uuid())
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  currentBalance Decimal  @default(0) @db.Decimal(18, 4)
  asOnDate       DateTime @default(now())
  isDeleted      Boolean  @default(false)
  // P0-2a: tenant scope. Nullable at the schema level, but the migration
  // (20260702000001_pettycash_tenant_scope) guarantees every existing row is
  // backfilled to a concrete owner — via its earliest bank-funded, expense,
  // or supplier-payment transaction, falling back to the install's primary
  // admin user for anything still unresolved — and application code always
  // stamps userId on create. Reads/writes (controllers/pettyCashController.ts)
  // use a strict `{ userId }` match; there is no cross-tenant null-row
  // fallback.
  userId         String?
  user           User?    @relation("UserPettyCash", fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions PettyCashTransaction[] @relation("PettyCashTransactions")

  @@index([userId])
}

model PettyCashTransaction {
  id              String                          @id @default(uuid())
