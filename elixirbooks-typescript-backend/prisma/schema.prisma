  cities     City[]    @relation("StateCities")
  users      User[]    @relation("StateUsers")
  taxRates   TaxRate[] @relation("TaxRateState")

  @@index([country_id])
}

model Country {
  id        String  @id @default(uuid())
  name      String?
  iso3      String?
  iso2      String?
  phonecode String?
