  @@index([employeeUserId])
}

model Timesheet {
  id             String          @id @default(uuid())
  userId         String // tenant
  employeeUserId String
  weekStartDate  DateTime // Monday, UTC midnight
  status         TimesheetStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee User        @relation("TimesheetEmployee", fields: [employeeUserId], references: [id])
  entries  TimeEntry[]

  @@unique([employeeUserId, weekStartDate])
  @@index([userId])
  @@index([status])
}

model TimeEntry {
  id          String   @id @default(uuid())
  timesheetId String
  projectId   String
  date        DateTime
  hours       Decimal  @db.Decimal(5, 2)
  billable    Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([date])
}

// =============================================================================
// Time Tracking — Phase C (Leaves + Holidays)
// =============================================================================

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeavePortion {
  FULL
  AM
  PM
}

model Holiday {
  id              String   @id @default(uuid())
  userId          String // tenant (raw, matches Project)
  name            String
  date            DateTime // UTC midnight (date-only)
  recurringYearly Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model LeaveType {
  id                    String   @id @default(uuid())
  userId                String // tenant
  name                  String
  paid                  Boolean  @default(true)
  defaultAllocationDays Decimal? @db.Decimal(5, 1)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  allocations LeaveAllocation[]
  requests    LeaveRequest[]

  @@unique([userId, name])
}

model LeaveAllocation {
  id              String   @id @default(uuid())
  userId          String // tenant
  employeeUserId  String
  leaveTypeId     String
  year            Int
  allocatedDays   Decimal  @db.Decimal(5, 1)
  carriedOverDays Decimal  @default(0) @db.Decimal(5, 1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee  User      @relation("LeaveAllocationEmployee", fields: [employeeUserId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeUserId, leaveTypeId, year])
  @@index([userId])
}

model LeaveRequest {
  id             String      @id @default(uuid())
  userId         String // tenant
  employeeUserId String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  status         LeaveStatus @default(PENDING)
  reason         String?
  totalDays      Decimal     @db.Decimal(5, 1)
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee  User              @relation("LeaveRequestEmployee", fields: [employeeUserId], references: [id])
  leaveType LeaveType         @relation(fields: [leaveTypeId], references: [id])
  days      LeaveRequestDay[]

  @@index([userId])
  @@index([employeeUserId])
  @@index([status])
}

model LeaveRequestDay {
  id             String       @id @default(uuid())
  leaveRequestId String
  date           DateTime
  portion        LeavePortion @default(FULL)
  portionDays    Decimal      @db.Decimal(2, 1)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date])
  @@index([date])
}

// =============================================================================
// P3.2 — Budgeting
// =============================================================================

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserBudgets", fields: [userId], references: [id])
  accountId   String
  account     Account  @relation("AccountBudgets", fields: [accountId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, accountId, periodStart])
}

// =============================================================================
// P3.4 — Fixed Assets + Depreciation
// =============================================================================

model FixedAsset {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation("UserFixedAssets", fields: [userId], references: [id])
  name                    String
  cost                    Decimal   @db.Decimal(18, 4)
  salvageValue            Decimal   @default(0) @db.Decimal(18, 4)
  usefulLifeMonths        Int
  method                  String    @default("STRAIGHT_LINE")
  acquisitionDate         DateTime
  accumulatedDepreciation Decimal   @default(0) @db.Decimal(18, 4)
  lastDepreciatedOn       DateTime?
  status                  String    @default("active") // active | disposed | fully_depreciated
  disposalDate            DateTime?
  disposalProceeds        Decimal?  @db.Decimal(18, 4)
  disposalJournalEntryId  String?
  isDeleted               Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId, status])
}

// =============================================================================
// P3.5 — Inventory FIFO Cost Layers
// =============================================================================

model InventoryCostLayer {
  id           String   @id @default(uuid())
  userId       String
  productId    String
  qtyRemaining Decimal  @db.Decimal(18, 4)
  unitCost     Decimal  @db.Decimal(18, 4)
  receivedAt   DateTime
  sourceType   String?
  sourceId     String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, productId, receivedAt])
}

model TransactionCategory {
  id               String            @id @default(uuid())
  userId           String
  code             String
  name             String
  group            CategoryGroup
  appliesTo        CategoryAppliesTo
  accountId        String
  account          Account           @relation("AccountTransactionCategories", fields: [accountId], references: [id])
  defaultTaxRateId String?
  defaultTaxRate   TaxRate?          @relation("TaxRateTransactionCategories", fields: [defaultTaxRateId], references: [id])
  taxApplicable    Boolean           @default(true)
  isSystem         Boolean           @default(false)
  status           Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bankTransactions BankTransaction[] @relation("CategoryBankTransactions")

  @@unique([userId, code])
}

// =============================================================================
// Models — Phase 2 Payroll
// =============================================================================

model PayrollProfile {
  id             String       @id @default(uuid())
  userId         String // owner / tenant (the company)
  user           User         @relation("CompanyPayrollProfiles", fields: [userId], references: [id])
  employeeUserId String
  employee       User         @relation("EmployeePayrollProfile", fields: [employeeUserId], references: [id])
  defaultGross   Decimal?     @db.Decimal(18, 4)
  payFrequency   PayFrequency @default(MONTHLY)
  isActive       Boolean      @default(true)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([employeeUserId])
}

model PayRun {
  id           String       @id @default(uuid())
  userId       String // owner / tenant
  user         User         @relation("CompanyPayRuns", fields: [userId], references: [id])
  taxYearLabel String
  taxMonth     Int
  periodStart  DateTime
  periodEnd    DateTime
  status       PayRunStatus @default(DRAFT)
  finalizedAt  DateTime?
  voidedAt     DateTime?
  isDeleted    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lines        PayRunLine[] @relation("PayRunLines")

  @@index([userId])
  @@index([userId, taxYearLabel, taxMonth])
}

model PayRunLine {
  id             String   @id @default(uuid())
  payRunId       String
  payRun         PayRun   @relation("PayRunLines", fields: [payRunId], references: [id], onDelete: Cascade)
  employeeUserId String
  employee       User     @relation("EmployeePayRunLines", fields: [employeeUserId], references: [id])
  gross          Decimal  @db.Decimal(18, 4)
  deductions     Decimal  @default(0) @db.Decimal(18, 4)
  net            Decimal  @db.Decimal(18, 4)
  deductionLines Json?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([payRunId])
  @@index([employeeUserId])
}

// =============================================================================
// Unified Contacts — Stage A
// =============================================================================

enum ContactStatus {
  ACTIVE
  HIDDEN
}

enum TaxTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
  REVERSE_CHARGE
  OUT_OF_SCOPE
}

model Contact {
  id                      String        @id @default(uuid())
  userId                  String
  user                    User          @relation("UserContacts", fields: [userId], references: [id])
  firstName               String?
  lastName                String?
  organisation            String?
  showNameOnInvoice       Boolean       @default(false)
  email                   String?
  billingEmail            String?
  telephone               String?
  mobile                  String?
  addressLine1            String?
  addressLine2            String?
  addressLine3            String?
  town                    String?
  region                  String?
  postcode                String?
  countryId               String?
  defaultPaymentTermDays  Int?
  useContactEmailSettings Boolean       @default(false)
  invoiceSequencePrefix   String?
  defaultTaxTreatment     TaxTreatment  @default(STANDARD)
  vatRegNumber            String?
  vatNumber               String? // customer VAT number (EU/UK), used for reverse-charge detection
  country                 String? // ISO country code, used for EU cross-border detection
  viesValid               Boolean? // last online VIES result (null = never checked / VIES disabled / non-EU)
  viesCheckedAt           DateTime? // audit: timestamp of the last VIES check
  gstin                   String?
  invoiceLanguage         String?
  currencyCode            String?
  bankDetails             Json?
  notes                   String?
  image                   String?
  status                  ContactStatus @default(ACTIVE)
  legacyCustomerId        String?
  legacySupplierId        String?
  isDeleted               Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Back-relations from party models (task 5: contactId FK columns)
  invoicesAsContact          Invoice[]                  @relation("InvoiceContact")
  invoicesAsBillToContact    Invoice[]                  @relation("InvoiceBillToContact")
  quotationsAsContact        Quotation[]                @relation("QuotationContact")
  quotationsAsBillToContact  Quotation[]                @relation("QuotationBillToContact")
  creditNotesAsContact       CreditNote[]               @relation("CreditNoteContact")
  creditNotesAsBillToContact CreditNote[]               @relation("CreditNoteBillToContact")
  challansAsContact          DeliveryChallan[]          @relation("DeliveryChallanContact")
  challansAsBillToContact    DeliveryChallan[]          @relation("DeliveryChallanBillToContact")
  remindersAsTarget          Reminder[]                 @relation("ReminderTargetContact")
  vehiclesAsContact          Vehicle[]                  @relation("VehicleContact")
  purchasesAsContact         Purchase[]                 @relation("PurchaseContact")
  purchaseOrdersAsContact    PurchaseOrder[]            @relation("PurchaseOrderContact")
  supplierPaymentsAsContact  SupplierPayment[]          @relation("SupplierPaymentContact")
  debitNotesAsContact        DebitNote[]                @relation("DebitNoteContact")
  debitNotesAsBillToContact  DebitNote[]                @relation("DebitNoteBillToContact")
  expensesAsContact          Expense[]                  @relation("ExpenseContact")
  recurringSchedules         RecurringInvoiceSchedule[] @relation("RecurringScheduleContact")
  accountCreditEntries       AccountCreditEntry[]       @relation("AccountCreditEntryContact")

  @@index([userId])
  @@index([userId, status])
  @@index([legacyCustomerId])
  @@index([legacySupplierId])
  @@index([email])
}

// =============================================================================
// Models — Banking Phase B: Learning store
// =============================================================================

model ExplanationHint {
  id                 String   @id @default(uuid())
  userId             String
  payeeKey           String // normalised payee/description
  transactionTypeKey String
  categoryId         String?
  payToUserId        String?
  hitCount           Int      @default(1)
  lastUsedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, payeeKey])
  @@index([userId])
}
