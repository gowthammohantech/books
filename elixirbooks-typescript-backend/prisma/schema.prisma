  supplierPaymentsCreated    SupplierPayment[]       @relation("UserSupplierPaymentsCreated")
  expenses                   Expense[]               @relation("UserExpenses")
  reimbursableExpenses       Expense[]               @relation("ExpensePaidBy")
  // Phase 2 — Payroll
  payrollProfilesOwned       PayrollProfile[]        @relation("CompanyPayrollProfiles")
  payrollProfile             PayrollProfile[]        @relation("EmployeePayrollProfile")
  companyPayRuns             PayRun[]                @relation("CompanyPayRuns")
  payRunLines                PayRunLine[]            @relation("EmployeePayRunLines")
  expenseChangeLogs          ExpenseChangeLog[]      @relation("UserExpenseChangeLogs")
  purchases                  Purchase[]              @relation("PurchaseUser")
  purchasesBillFrom          Purchase[]              @relation("PurchaseBillFrom")
  purchasesBillTo            Purchase[]              @relation("PurchaseBillTo")
  purchaseOrders             PurchaseOrder[]         @relation("PurchaseOrderUser")
  purchaseOrdersBillFrom     PurchaseOrder[]         @relation("PurchaseOrderBillFrom")
  purchaseOrdersBillTo       PurchaseOrder[]         @relation("PurchaseOrderBillTo")
  companySettings            CompanySettings?        @relation("UserCompanySettings")
