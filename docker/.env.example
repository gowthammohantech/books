# =============================================================================
# Elixir Books environment template.  Copy to docker/.env and fill in real values:
#     cp docker/.env.example docker/.env
# docker/.env is gitignored — never commit real secrets.  See documentation/operations/deployment.md.
# =============================================================================

# === API ===
NODE_ENV=production
PORT=3001

# CHANGE ME — long random string.  Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# CHANGE ME — unique per install.  32-byte hex key (AES-256-GCM) that encrypts
# stored BYOK provider keys.  Generate with:  openssl rand -hex 32
# Leaving it blank makes the app derive a key from JWT_SECRET (with a warning);
# set it explicitly in production so encrypted keys survive JWT_SECRET rotations.
AI_ENCRYPTION_KEY=
# Per-user daily AI call quota.  Blank = default of 200.
AI_MAX_CALLS_PER_DAY=

# Optional providers (leave blank if unused — also configurable in-app as BYOK)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WHATSAPPCRM_API_KEY=

# Mail (SMTP) — required for invoice emails / reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Baseline data is seeded automatically on container boot (idempotent).
# Set to false only after the first successful boot for slightly faster restarts.
SEED_ON_BOOT=true

# === Object storage (every uploaded file: logos, signatures, receipts, bills) ===
# Uploads are NOT stored on disk. They live in a private Azure Blob container and
# are served to the browser as signed URLs that expire.
#
# The default below is Azurite's well-known development account, matching the
# `azurite` service in docker-compose.yml. IN AZURE, replace it with the real
# storage account's connection string (it must include AccountKey=, which is what
# signs the read URLs).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=uploads
# How long a signed read URL stays valid. A tab left open longer than this shows
# broken images until it is reloaded.
AZURE_STORAGE_SAS_TTL_MINUTES=60
# The blob endpoint the BROWSER reaches, when it differs from the one the api
# container uses. Under compose the api talks to `azurite:10000` (a name only
# resolvable inside the docker network) while the browser needs `localhost:10000`,
# so signed URLs are rewritten onto this origin before they are returned.
# LEAVE EMPTY IN AZURE — there the endpoint is already the public one.
AZURE_STORAGE_PUBLIC_ENDPOINT=http://localhost:10000/devstoreaccount1
# Host port for Azurite. Must match the port in AZURE_STORAGE_PUBLIC_ENDPOINT.
AZURITE_PORT=10000

# === Postgres (the application datastore) ===
POSTGRES_USER=elixirbooks
# CHANGE ME — strong unique password; must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=elixirbooks
DATABASE_URL=postgresql://elixirbooks:change-me-strong-password@postgres:5432/elixirbooks?schema=public

# === Web (BUILD-TIME — rebuild the web image after changing these) ===
WEB_PORT=8080
VITE_DEMO_MODE=false
# Leave EMPTY so the SPA calls a relative /api (nginx proxies it to the API).
# Only set to an absolute URL if the API is hosted on a different domain.
VITE_API_BASE_URL=

# RUNTIME (no rebuild needed): the origin nginx proxies /api to.
#   http://api:3001     the compose api service (default)
#   https://<api-host>  an API on another domain, proxied same-origin so the
#                       browser never makes a cross-origin call (no CORS). The
#                       Host header and SNI are set to <api-host> automatically,
#                       which is what managed platforms route on. Pair it with
#                       an EMPTY VITE_API_BASE_URL.
#   (empty)             no proxy at all — for a standalone web container whose
#                       SPA calls an absolute VITE_API_BASE_URL directly.
API_ORIGIN=http://api:3001

# === Optional: Redis (only used with `--profile redis` for the async worker) ===
REDIS_URL=redis://redis:6379

