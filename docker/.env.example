# =============================================================================
# Elixir Books environment template.  Copy to docker/.env and fill in real values:
#     cp docker/.env.example docker/.env
# docker/.env is gitignored — never commit real secrets.  See DEPLOYMENT.md.
# =============================================================================

# === API ===
NODE_ENV=production
PORT=3001

# CHANGE ME — long random string.  Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# CHANGE ME — unique per install.  32-byte hex key (AES-256-GCM) that encrypts
# stored BYOK provider keys.  Generate with:  openssl rand -hex 32
# Leaving it blank makes the app derive a key from JWT_SECRET (with a warning);
# set it explicitly in production so encrypted keys survive JWT_SECRET rotations.
AI_ENCRYPTION_KEY=
# Per-user daily AI call quota.  Blank = default of 200.
AI_MAX_CALLS_PER_DAY=

# Optional providers (leave blank if unused — also configurable in-app as BYOK)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WHATSAPPCRM_API_KEY=

# Mail (SMTP) — required for invoice emails / reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Baseline data is seeded automatically on container boot (idempotent).
# Set to false only after the first successful boot for slightly faster restarts.
SEED_ON_BOOT=true

# === Postgres (the application datastore) ===
POSTGRES_USER=elixirbooks
# CHANGE ME — strong unique password; must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=elixirbooks
DATABASE_URL=postgresql://elixirbooks:change-me-strong-password@postgres:5432/elixirbooks?schema=public

# === Web (BUILD-TIME — rebuild the web image after changing these) ===
WEB_PORT=8080
VITE_DEMO_MODE=false
# Leave EMPTY so the SPA calls a relative /api (nginx proxies it to the API).
# Only set to an absolute URL if the API is hosted on a different domain.
VITE_API_BASE_URL=

# === Optional: Redis (only used with `--profile redis` for the async worker) ===
REDIS_URL=redis://redis:6379

