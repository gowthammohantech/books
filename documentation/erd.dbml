  userId varchar [unique, not null]
  taxRegime TaxRegime [not null, default: 'NONE']
  countryId varchar
  stateId varchar
  publicBaseUrl varchar
  merchantUpiId varchar
  merchantName varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  countryCode varchar
  functionalCurrency varchar
  fiscalYearStartMonth integer
  goLiveDate timestamp
  ledgerInitialized boolean [not null, default: false]
  approvalsEnabled boolean [not null, default: false]
  bankAutoPostEnabled boolean [not null, default: false, note: 'Per-tenant AUTO-POST tier for bank-transaction auto-matching. OFF BY DEFAULT — preserves the existing queue behaviour (AUTO matches only fill the approval queue). When ON, near-certain matches (see autoPostEligible in lib/moneyFlow/autoMatc']
  itemPickerShowRate boolean [not null, default: true, note: 'Invoice item-picker display toggles — per-tenant, control which extra columns/affordances show in the invoice line-item product picker.']
  itemPickerShowStock boolean [not null, default: true]
  itemPickerShowImage boolean [not null, default: false]
  viesValidationEnabled boolean [not null, default: false, note: 'OPTIONAL online EU VIES VAT-number validation. OFF BY DEFAULT — VIES is an outbound call to the EU government service, so it must never fire unless the tenant explicitly opts in. Validation is fail-open and non-blocking: a save is never rej']
  ossRegistered boolean [not null, default: false, note: 'EU One-Stop-Shop (OSS) registration. When ON, B2C cross-border EU supplies are taxed at the DESTINATION member-state rate (instead of origin). OFF BY DEFAULT — additive / backward-compatible; reverse-charge (B2B) and domestic behaviour are ']
  gstin varchar [note: 'Tax registration identifiers (tenant-level). Nullable / additive — null = not registered. India GSTIN (also used by e-invoicing)']
  vatNumber varchar [note: 'UK / EU VAT registration number']
  abn varchar [note: 'Australia Business Number']
  nzGstNumber varchar [note: 'New Zealand GST registration number']
}

