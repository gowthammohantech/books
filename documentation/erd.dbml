  stopped boolean [not null, default: false]
  lastRecurringDate timestamp
  nextRecurringDate timestamp
  recurringScheduleId varchar [note: 'New recurring engine: generated occurrences link to their schedule (additive; replaces the old parent-invoice engine above).']
  sign_type SignType [not null, default: 'none']
  signatureName varchar
  signatureId varchar
  signatureImage varchar
  isDeleted boolean [not null, default: false]
  userId varchar [not null]
  billFrom varchar [not null]
  billTo varchar
  vehicleId varchar
  invoiceType InvoiceType [not null, default: 'INVOICE']
  convertedFromId varchar
  convertedAt timestamp
  publicViewToken varchar [unique]
  publicViewEnabled boolean [not null, default: false]
  paymentOptions jsonb [note: 'Per-invoice "Pay with" links shown on the public view. Array of { name, url }.']
  approvalStatus ApprovalStatus [not null, default: 'NOT_REQUIRED']
  approvedById varchar
  approvedAt timestamp
  rejectionReason varchar
  currencyCode varchar
  exchangeRate decimal(18,8)
  costCenterId varchar
  projectId varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table RecurringInvoiceSchedule {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null, note: 'tenant scope (raw string, app-enforced — mirrors Invoice/Contact tenant column)']
  name varchar [note: 'human label for the schedule']
  contactId varchar
  currencyCode varchar
  taxTreatment TaxTreatment
  items jsonb [not null, note: 'Invoice template snapshot (line items + amounts); rendered into a real Invoice at each run.']
  taxableAmount decimal(18,4) [not null]
  totalDiscount decimal(18,4)
  totalTax decimal(18,4)
  roundOff decimal(18,4)
  TotalAmount decimal(18,4) [not null]
  notes varchar
  termsAndCondition varchar
  signatureId varchar
  billFrom varchar
  repeatEvery RecurrenceFrequency [not null, default: 'month', note: 'Cadence (reuses the existing recurrence enums)']
  customIntervalNumber integer
  customIntervalType RecurrenceCustomIntervalType
  startOn timestamp [not null, note: 'End conditions']
  endsOn timestamp
  neverExpire boolean [not null, default: false]
  maxOccurrences integer
  status RecurringScheduleStatus [not null, default: 'ACTIVE', note: 'Lifecycle']
  nextRunDate timestamp
  lastRunDate timestamp
  occurrencesCount integer [not null, default: 0]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    userId
    status
  }
}

Table InvoicePayment {
  id varchar [pk, not null, default: `uuid()`]
  invoiceId varchar [not null]
  amount decimal(18,4) [not null]
