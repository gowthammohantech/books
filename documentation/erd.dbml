}

Table Budget {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  accountId varchar [not null]
  periodStart timestamp [not null]
  periodEnd timestamp [not null]
  amount decimal(18,4) [not null]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, accountId, periodStart)
  }
}

Table FixedAsset {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  name varchar [not null]
  cost decimal(18,4) [not null]
  salvageValue decimal(18,4) [not null, default: 0]
  usefulLifeMonths integer [not null]
  method varchar [not null, default: 'STRAIGHT_LINE']
  acquisitionDate timestamp [not null]
  accumulatedDepreciation decimal(18,4) [not null, default: 0]
  lastDepreciatedOn timestamp
  status varchar [not null, default: 'active', note: 'active | disposed | fully_depreciated']
  disposalDate timestamp
  disposalProceeds decimal(18,4)
  disposalJournalEntryId varchar
