// ---------------------------------------------------------------------------
// Table groups (subject areas) - collapse/expand these in dbdiagram.io
// ---------------------------------------------------------------------------

// Auth & RBAC
TableGroup auth_rbac {
  User
  Role
  Permission
  Module
  LoginActivity
}

// Contacts & Parties
TableGroup contacts_parties {
  Contact
  Customer
  Supplier
}

// Products, Inventory & Banking
TableGroup core_entities {
  Product
  Category
  Brand
  Inventory
  Unit
  BankDetail
  BankTransaction
  ExplanationHint
  Signature
  Vehicle
}

// Sales & Invoicing
TableGroup sales_invoicing {
  Invoice
  InvoicePayment
  RecurringInvoiceSchedule
  InvoiceTemplate
  Quotation
  CreditNote
  DebitNote
  DeliveryChallan
  AccountCreditEntry
  Counter
  Reminder
  EmailTemplate
}

// Purchases & Expenses
TableGroup purchases_expenses {
  Purchase
  PurchaseOrder
  SupplierPayment
  Expense
  ExpenseCategory
  ExpenseChangeLog
  PettyCash
  PettyCashTransaction
}

// Accounting & Ledger
TableGroup accounting_ledger {
  Account
  JournalEntry
  JournalLine
  LedgerAccountMapping
  AccountingPeriod
  TransactionCategory
  Budget
  FixedAsset
  InventoryCostLayer
  CostCenter
  Project
}

// Payment Gateways
TableGroup payments {
  GatewayConfig
  PaymentLinkMethod
  PaymentTransaction
  Refund
}

// Payroll
TableGroup payroll {
  PayrollProfile
  PayRun
  PayRunLine
}

// Time Tracking & Leave
TableGroup time_tracking {
  ProjectMember
  Timesheet
  TimeEntry
  Holiday
  LeaveType
  LeaveAllocation
  LeaveRequest
  LeaveRequestDay
}

// Tax & Compliance
TableGroup tax_compliance {
  TaxGroup
  TaxRate
  _TaxGroupTaxRates
  EInvoiceRecord
  MtdConfig
  AccountingIntegration
}

// Configuration & Geography
TableGroup config_geo {
  CompanySettings
  GeneralSetting
  Localization
  EmailSettings
  MessagingConfig
  Currency
  ExchangeRate
  DateFormat
  TimeFormat
  Timezone
  PaymentMode
  Country
  State
  City
}

// Custom Fields & Notifications
TableGroup custom_fields {
  CustomField
  CustomFieldDataType
  CustomFieldValue
  FieldType
  NotificationTag
  NotificationType
  NotificationTypeTag
}

// AI Assistant
TableGroup ai {
  AiConfig
  AiExtractionJob
  AiChatSession
  AiChatMessage
  AiUsageLog
  AIChatSession
  AIConfiguration
  AIPromptLog
  AIPromptTemplate
  Conversation
}

// Audit Trail
TableGroup audit {
  AuditLog
}

// ---------------------------------------------------------------------------
// Soft references (NOT enforced by a foreign key - documented for completeness)
// ---------------------------------------------------------------------------
//
// Polymorphic (entityType/sourceType discriminator + id, resolved in the service layer):
//   AuditLog.entityType + AuditLog.entityId       -> any audited table
//   InventoryCostLayer.sourceType + .sourceId     -> Purchase | Invoice | Inventory
//   JournalEntry.sourceType + .sourceId           -> the posted source document:
//     Invoice | InvoicePayment | CreditNote | DebitNote | Purchase | SupplierPayment |
//     Expense | PayRunLine | AccountCreditEntry | FixedAssetDisposal | BankTxnExplain | Cutover
//     (unique per tenant: @@unique([userId, sourceType, sourceId, event]) - the posting idempotency key)
//
// Plain scalar tenant/dimension FKs left unrelated in the Prisma schema:
//   CostCenter.userId, Project.userId, TransactionCategory.userId,
//   InventoryCostLayer.userId, InventoryCostLayer.productId  -> User.id / Product.id
//
// Tenancy: every business table is scoped by userId, where the effective tenant
// id is User.ownerId ?? User.id (see lib/tenantScope.ts). Staff users share the
// owner's dataset via the User.ownerId self-relation.
