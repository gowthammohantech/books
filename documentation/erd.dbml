Table Role {
  id varchar [pk, not null, default: `uuid()`]
  roleName varchar [not null]
  status boolean [not null, default: true]
  defaultRoute varchar [default: 'dashboard']
  createdBy varchar
  deletedAt timestamp
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table User {
  id varchar [pk, not null, default: `uuid()`]
  firstName varchar [not null]
  lastName varchar
  email varchar [unique, not null]
  phone varchar
  gender UserGender
  dateOfBirth timestamp
  password varchar [not null]
  profileImage varchar
  address varchar
  countryId varchar
  stateId varchar
  cityId varchar
  postalCode varchar
  user_type integer [not null, default: 1]
  roleId varchar
  ownerId varchar [note: 'Shared-workspace tenancy: links a staff/admin user to the sole company owner (the single user_type:1 account). `ownerId = null` means the row IS the owner, so the tenant id resolves to `ownerId ?? id` and every member of a company shares on']
  balance decimal(18,4) [not null, default: 0]
  balance_type UserBalanceType
  isDeleted boolean [not null, default: false]
  deletedAt timestamp
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table BankDetail {
  id varchar [pk, not null, default: `uuid()`]
  accountHoldername varchar [not null]
  bankName varchar [not null]
  branchName varchar [not null]
  accountNumber varchar [not null, note: 'Uniqueness is enforced by a PARTIAL unique index over active (isDeleted = false) rows only — see migration 20260711000000_bankdetail_active_unique_ accountnumber. Prisma can\'t express `WHERE isDeleted = false`, so no @unique here; a soft-d']
  bankCodeType varchar [note: 'BC.2: regional bank-code format stored in IFSCCode (IFSC, SORT_CODE, ROUTING, IBAN, SWIFT, BSB, OTHER); null = legacy (treat as IFSC)']
  IFSCCode varchar [not null]
  accountType BankAccountType [not null]
  openingBalance decimal(18,4) [default: 0]
  currentBalance decimal(18,4) [default: 0]
  asOnDate timestamp [default: `now()`]
  currencyCode varchar [note: 'BC.1: per-account currency (ISO code, e.g. \'USD\'); null = company base currency']
  isDeleted boolean [not null, default: false]
  status boolean [not null, default: true]
  userId varchar [not null]
  accountId varchar [note: 'A1: per-bank GL sub-account under the tenant\'s BANK control account, so each bank reconciles independently. Null = falls back to the shared BANK role account.']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    userId
    isDeleted
    status
  }
}

Table BankTransaction {
  id varchar [pk, not null, default: `uuid()`]
  bankAccountId varchar [not null]
  transactionDate timestamp [not null, default: `now()`]
  type BankTransactionType [not null]
  amount decimal(18,4) [not null]
  balanceBefore decimal(18,4) [not null]
  balanceAfter decimal(18,4) [not null]
  paymentModeId varchar [not null]
  referenceNo varchar
  remarks varchar
  relatedType BankTransactionRelatedType [default: 'MANUAL']
  relatedId varchar
  isReconciled boolean [not null, default: false]
  reconciledBy varchar
  reconciliationDate timestamp
  reconciliationNote varchar
  isDeleted boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  explainStatus ExplainStatus [not null, default: 'UNEXPLAINED']
  transactionTypeKey varchar
  categoryId varchar
  payToUserId varchar
  taxTreatment varchar
  taxAmount decimal(18,4)
  explainedDescription varchar
  attachment varchar
  assetType varchar
  depreciationMethod varchar
  assetLifeMonths integer
  userPaymentReason varchar
  approvedById varchar
  approvedAt timestamp
  postedSourceType varchar
  postedSourceId varchar
  createdAssetId varchar
  proposedRelatedType varchar
  proposedRelatedId varchar
  matchConfidence varchar
  matchScore integer
  proposedTransactionTypeKey varchar
  proposedCategoryId varchar
  autoPosted boolean [not null, default: false, note: 'Marks rows posted to the GL by the AUTO-POST tier (skipping the approval queue). Drives the FE badge + Undo affordance and is cleared by unexplain.']
  isPaymentBorn boolean [not null, default: false, note: 'True when this row was CREATED by a module payment flow (invoice payment, supplier payment, expense, petty-cash) — see lib/moneyFlow/explainedBankFields.ts. Payment-born rows are read-only in banking (edit at source); banking-explained rows']

  indexes {
    bankAccountId
    transactionDate
    (relatedType, relatedId)
    isDeleted
  }
}

