  received_on timestamp [not null]
  notes varchar [default: '']
  received_by varchar [not null]
  paymentTransactionId varchar
  currencyCode varchar
  exchangeRate decimal(18,8)
  reference varchar
  movedBankBalance boolean [not null, default: false, note: 'TRUE iff this payment\'s CREATE path moved bankDetail.currentBalance (the record path recordInvoicePayment writes its own bank line + moves the register). FALSE for the bank-reconciliation EXPLAIN flow (applyInvoiceReceipt), where a pre-exi']
  isVoided boolean [not null, default: false]
  voidedById varchar
  voidedAt timestamp
  voidReason varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table AccountCreditEntry {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  contactId varchar [not null]
  type AccountCreditEntryType [not null]
  amount decimal(18,4) [not null, note: 'always positive; sign implied by type']
  reason varchar
  invoiceId varchar
  invoicePaymentId varchar
  currencyCode varchar
  isVoided boolean [not null, default: false]
  voidedById varchar
  voidedAt timestamp
  voidReason varchar
  createdById varchar [not null]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, contactId)
    invoiceId
    invoicePaymentId
  }
}

