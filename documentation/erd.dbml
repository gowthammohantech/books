    (userId, fromCurrency, toCurrency, asOfDate)
  }
}

Table CostCenter {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  code varchar [not null]
  name varchar [not null]
  description varchar
  type CostCenterType [not null, default: 'BOTH', note: '/ PROFIT centres earn revenue, COST centres only absorb cost, BOTH does / either. Defaults to BOTH so pre-existing centres keep their full reach.']
  isActive boolean [not null, default: true]
  isDeleted boolean [not null, default: false]
  parentId varchar [note: '/ Roll-up hierarchy, e.g. Division > Department.']
  numberPrefix varchar [note: '/ Per-centre document numbering. A centre with a `numberPrefix` issues its / own series (SAL-000001, ACAD-000001, ...) counted by `nextNumber`; a centre / without one falls back to the install-wide sequence in GeneralSetting.']
  nextNumber integer [not null, default: 1]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, code) [unique]
    (userId, numberPrefix) [unique]
    userId
    parentId
    (userId, isDeleted)
  }
}

Table Project {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  code varchar [not null]
