  isSystem boolean [not null, default: false]
  status boolean [not null, default: true]
  isDeleted boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, code) [unique]
  }
}

Table PayrollProfile {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null, note: 'owner / tenant (the company)']
  employeeUserId varchar [not null]
  defaultGross decimal(18,4)
  payFrequency PayFrequency [not null, default: 'MONTHLY']
  isActive boolean [not null, default: true]
  isDeleted boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    userId
    employeeUserId
  }
}

Table PayRun {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null, note: 'owner / tenant']
  taxYearLabel varchar [not null]
  taxMonth integer [not null]
  periodStart timestamp [not null]
  periodEnd timestamp [not null]
  status PayRunStatus [not null, default: 'DRAFT']
  finalizedAt timestamp
  voidedAt timestamp
  isDeleted boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    userId
    (userId, taxYearLabel, taxMonth)
  }
}

Table PayRunLine {
  id varchar [pk, not null, default: `uuid()`]
  payRunId varchar [not null]
  employeeUserId varchar [not null]
  gross decimal(18,4) [not null]
  deductions decimal(18,4) [not null, default: 0]
  net decimal(18,4) [not null]
  deductionLines jsonb
  note varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    payRunId
    employeeUserId
  }
}

Table Contact {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  firstName varchar
  lastName varchar
  organisation varchar
  showNameOnInvoice boolean [not null, default: false]
  email varchar
  billingEmail varchar
  telephone varchar
  mobile varchar
  addressLine1 varchar
  addressLine2 varchar
  addressLine3 varchar
  town varchar
  region varchar
  postcode varchar
  countryId varchar
  defaultPaymentTermDays integer
  useContactEmailSettings boolean [not null, default: false]
  invoiceSequencePrefix varchar
  defaultTaxTreatment TaxTreatment [not null, default: 'STANDARD']
  vatRegNumber varchar
  vatNumber varchar [note: 'customer VAT number (EU/UK), used for reverse-charge detection']
  country varchar [note: 'ISO country code, used for EU cross-border detection']
  viesValid boolean [note: 'last online VIES result (null = never checked / VIES disabled / non-EU)']
  viesCheckedAt timestamp [note: 'audit: timestamp of the last VIES check']
  gstin varchar
  invoiceLanguage varchar
  currencyCode varchar
  bankDetails jsonb
  notes varchar
  image varchar
  status ContactStatus [not null, default: 'ACTIVE']
  legacyCustomerId varchar
  legacySupplierId varchar
  isDeleted boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    userId
    (userId, status)
    legacyCustomerId
    legacySupplierId
    email
  }
}

Table ExplanationHint {
  id varchar [pk, not null, default: `uuid()`]
  userId varchar [not null]
  payeeKey varchar [not null, note: 'normalised payee/description']
  transactionTypeKey varchar [not null]
  categoryId varchar
  payToUserId varchar
  hitCount integer [not null, default: 1]
  lastUsedAt timestamp [not null, default: `now()`]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, payeeKey) [unique]
    userId
  }
}

// ---------------------------------------------------------------------------
// Implicit many-to-many join tables
// ---------------------------------------------------------------------------

Table _TaxGroupTaxRates {
  A varchar [not null, note: 'FK -> TaxGroup.id']
  B varchar [not null, note: 'FK -> TaxRate.id']

  indexes {
    (A, B) [unique]
    B
  }

  Note: 'Prisma implicit m2m join table: a tax group bundles several tax rates (e.g. GST = CGST + SGST).'
}

