  description varchar
  status varchar [not null, default: 'active']
  billingRate decimal(12,2)
  startDate timestamp
  endDate timestamp
  contactId varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, code) [unique]
    userId
  }
}

