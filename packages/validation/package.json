{
  "name": "@elixirbooks/validation",
  "version": "2.9.0",
  "private": true,
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package-marker.mjs dist/esm",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "~2.1.9"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  }
}
